{
  "manifest_version": 2,
  "name": "Facebook Video Subtitles",
  "version": "1.1.0",
  "description": "Auto-generate and overlay subtitles on Facebook videos using AI or STT",
  "author": "NaievetestV2",
  "homepage_url": "https://github.com/NaievetestV2/Facebook-Subtitles",
  "browser_specific_settings": {
    "gecko": {
      "id": "fb-subtitles@naievetest.dev",
      "strict_min_version": "78.0"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.akamaihd.net/*",
    "https://*.cdninstagram.com/*",
    "downloads"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://m.facebook.com/*",
        "https://web.facebook.com/*",
        "https://fb.watch/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "assets/*"
  ]
}
